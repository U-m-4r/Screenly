generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Interview {
  id              String          @id @default(uuid())
  githubMetadata  Json
  status          InterviewStatus
  score           Int             @default(0)
  summary         String?
  strengths       Json?
  improvements    Json?
  categories      Json?
  topics          Json?
  conversations   Message[]
}

model Message {
  id          String      @id @default(uuid())
  message     String
  type        MessageType
  createdAt   DateTime    @default(now())
  interviewId String
  interview   Interview   @relation(fields: [interviewId], references: [id])
}

enum MessageType {
  User
  Assistant
}

enum InterviewStatus {
  Pre
  InProgress
  Done
}