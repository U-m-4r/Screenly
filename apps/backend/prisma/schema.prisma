generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Interview {
  id             String          @id @default(uuid())
  githubMetadata Json
  status         InterviewStatus
  score          Int             @default(0)
  categories     Json?
  improvements   Json?
  strengths      Json?
  summary        String?
  topics         Json?
  conversations  Message[]
}

model Message {
  id          String      @id @default(uuid())
  message     String
  type        MessageType
  interviewId String
  createdAt   DateTime    @default(now())
  interview   Interview   @relation(fields: [interviewId], references: [id])
}

enum MessageType {
  User
  Assistant
}

enum InterviewStatus {
  Pre
  InProgress
  Done
}
